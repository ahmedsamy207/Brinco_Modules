{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Cortex Debug OpenOCD Launch",
			"type": "cortex-debug",
			"request": "launch",
			"toolchainPrefix": "arm-none-eabi",
			"servertype": "openocd",
			"configFiles": ["py32f0xx.cfg"],
			"searchDir": ["${config:openocd.scriptsPath}"],
			"executable": "${workspaceFolder}/Build/${workspaceFolderBasename}.elf",
			"runToEntryPoint": "main",
			"preLaunchTask": "Build",
			"svdFile": "${workspaceFolder}/Misc/SVD/py32f002axx.svd", 
			"showDevDebugOutput": "raw"
		},
		{
			"name": "Cortex Debug OpenOCD Attach",
			"type": "cortex-debug",
			"request": "attach",
			"toolchainPrefix": "arm-none-eabi",
			"servertype": "openocd",
			"configFiles": ["py32f0xx.cfg"],
			"searchDir": ["${config:openocd.scriptsPath}"],
			"executable": "${workspaceFolder}/Build/${workspaceFolderBasename}.elf",
			"svdFile": "${workspaceFolder}/Misc/SVD/py32f002axx.svd",
			"showDevDebugOutput": "raw"
		},
		{
			"name": "Cortex Debug pyOCD Launch",
			"type": "cortex-debug",
			"request": "launch",
			"toolchainPrefix": "arm-none-eabi",
			"servertype": "pyocd",
			"targetId": "PY32F040xB",
			"executable": "${workspaceFolder}/Build/${workspaceFolderBasename}.elf",
			"runToEntryPoint": "Reset_Handler",
			"preLaunchTask": "Build",
			"postLaunchCommands": [
				"monitor reset halt"
			],
			"showDevDebugOutput": "both"
		},
		{
			"name": "Cortex Debug pyOCD Attach",
			"type": "cortex-debug",
			"request": "attach",
			"toolchainPrefix": "arm-none-eabi",
			"servertype": "pyocd",
			"targetId": "PY32F040xB",
			"executable": "${workspaceFolder}/Build/${workspaceFolderBasename}.elf",
			"showDevDebugOutput": "raw"
		},
		{
			"name": "External pyOCD Attach",
			"type": "cortex-debug",
			"request": "attach",
			"servertype": "external",
			"gdbTarget": "localhost:50000",
			"toolchainPrefix": "arm-none-eabi",
			"executable": "${workspaceFolder}/Build/${workspaceFolderBasename}.elf",
			"preLaunchTask": "Start pyOCD Server",
			"showDevDebugOutput": "raw"
		},
		{
			"name": "External pyOCD Launch",
			"type": "cortex-debug",
			"request": "launch",
			"servertype": "external",
			"gdbPath": "gdb-multiarch",
			"gdbTarget": "100.92.235.44:50000",
			"executable": "${workspaceFolder}/Build/${workspaceFolderBasename}.elf",
			"runToEntryPoint": "Reset_Handler",
			"postLaunchCommands": [
				"monitor reset halt"
			],
			"showDevDebugOutput": "both"
		}
	]
}
